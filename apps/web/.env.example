# Copy to `.env.local` and fill in to add an Alchemy Arc RPC endpoint.
# Zero-setup default: leave unset and the app falls back to Arc's public endpoints.
#
# Alchemy hosts Arc (L1) natively. Create a free app for ARC Testnet at
# https://dashboard.alchemy.com and use its API key:
#   NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://arc-testnet.g.alchemy.com/v2/<API_KEY>
#
# Note on Alchemy plan tiers:
# - Free tier caps eth_getLogs to a 10-block range, so dashboard history/feed
#   requests still use Arc's public node (primary transport). The Alchemy
#   endpoint is used as the fallback for reads and checkout receipt waiting.
# - Upgrade to PAYG for "expanded block range" if you want Alchemy to serve the
#   historical backfill directly.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=

# Arc mainnet is live: gateway 0x6A1aAc76FF4A9F1F2370E6578aC53DBdF5143815.
# Leave blank to fall back to Arc's public endpoint.
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=

# Which Arc network the app targets when a request does not specify one.
# 5042 = Arc Mainnet (default), 5042002 = Arc Testnet.
# This decides where a payment with no ?chainId= actually settles, so set it
# deliberately rather than relying on the default.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=5042

# Optional. Reown Cloud projectId. When set, the navbar offers the
# WalletConnect connector (mobile QR). Leave blank to ship browser-extension
# wallets plus Coinbase only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=