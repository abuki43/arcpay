{
  "name": "@arcpay/sdk",
  "version": "0.1.0",
  "description": "Developer-first payment SDK for Arc Network with native USDC gas, 0.4% protocol fee model, and sub-second settlement.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/server.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
