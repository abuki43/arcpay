{
  "name": "@arcpay/sdk",
  "version": "0.1.0",
  "description": "Developer-first payment SDK for Arc Network with native USDC gas, 0.4% protocol fee model, and sub-second settlement.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.mjs",
      "require": "./dist/element.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/server.ts src/element.ts src/utils.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/react.tsx src/server.ts src/element.ts src/utils.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "viem": "^2.23.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
